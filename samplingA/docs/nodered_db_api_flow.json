    {
        "id": "http_sampling",
        "type": "http in",
        "z": "flow_db_api",
        "name": "采样查询",
        "url": "/api/db/sampling",
        "method": "get",
        "upload": false,
        "x": 140,
        "y": 160,
        "wires": [
            [
                "build_sampling_query"
            ]
        ]
    },
    {
        "id": "build_sampling_query",
        "type": "function",
        "z": "flow_db_api",
        "name": "构建采样查询",
        "func": "var deviceId = msg.req.query.device_id;\nvar page = parseInt(msg.req.query.page) || 1;\nvar pageSize = parseInt(msg.req.query.page_size) || 50;\nvar offset = (page - 1) * pageSize;\nif (!deviceId) {\n    msg.payload = { success: false, message: '请提供设备ID' };\n    return [null, msg];\n}\nmsg.params = [deviceId, pageSize, offset];\nmsg.query = \"SELECT id, \\\"桶号\\\" AS bucket, \\\"模式\\\" AS mode, \\\"实际采样量\\\" AS amount, \\\"开始时间\\\" AS start_time, \\\"结果\\\" AS result FROM \\\"采样事件\\\" WHERE \\\"设备ID\\\" = $1 ORDER BY id DESC LIMIT $2 OFFSET $3\";\nreturn [msg, null];",
        "outputs": 2,
        "x": 340,
        "y": 160,
        "wires": [
            [
                "pg_sampling"
            ],
            [
                "http_sampling_resp"
            ]
        ]
    },
    {
        "id": "pg_sampling",
        "type": "postgresql",
        "z": "flow_db_api",
        "name": "查询采样记录",
        "query": "",
        "postgreSQLConfig": "pg_config",
        "split": false,
        "rowsPerMsg": 1,
        "outputs": 1,
        "x": 540,
        "y": 160,
        "wires": [
            [
                "format_sampling"
            ]
        ]
    },
    {
        "id": "format_sampling",
        "type": "function",
        "z": "flow_db_api",
        "name": "格式化采样数据",
        "func": "msg.payload = {\n    success: true,\n    type: \"Sampling\",\n    data: msg.payload || []\n};\nreturn msg;",
        "outputs": 1,
        "x": 760,
        "y": 160,
        "wires": [
            [
                "http_sampling_resp"
            ]
        ]
    },
    {
        "id": "http_sampling_resp",
        "type": "http response",
        "z": "flow_db_api",
        "name": "返回采样数据",
        "statusCode": "200",
        "headers": {
            "Content-Type": "application/json"
        },
        "x": 940,
        "y": 160,
        "wires": []
    },
